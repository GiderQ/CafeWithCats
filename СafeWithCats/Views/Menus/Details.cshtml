@model CafeWithCats.Models.Menu

@{
    ViewData["Title"] = "Menu Details";
}

<h1>Menu Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Language</dt>
    <dd class="col-sm-9">@Model.Language</dd>

    <dt class="col-sm-3">Cafe ID</dt>
    <dd class="col-sm-9">@Model.CafeId</dd>
</dl>

@if (Model.MenuDishes?.Any() == true)
{
    <h4 class="mt-4">Dishes</h4>
    <table class="table table-sm table-bordered">
        <thead><tr><th>Name</th><th>Price</th><th>Weight</th></tr></thead>
        <tbody>
        @foreach (var md in Model.MenuDishes)
        {
            <tr>
                <td>@md.Dish.Name</td>
                <td>@md.Dish.Price.ToString("C")</td>
                <td>@md.Dish.Weight g</td>
            </tr>
        }
        </tbody>
    </table>
}

@if (Model.MenuDrinks?.Any() == true)
{
    <h4 class="mt-4">Drinks</h4>
    <table class="table table-sm table-bordered">
        <thead><tr><th>Name</th><th>Price</th><th>Volume</th><th>Alcoholic</th></tr></thead>
        <tbody>
        @foreach (var md in Model.MenuDrinks)
        {
            <tr>
                <td>@md.Drink.Name</td>
                <td>@md.Drink.Price.ToString("C")</td>
                <td>@md.Drink.Volume ml</td>
                <td>@(md.Drink.IsAlcoholic ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
}

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>