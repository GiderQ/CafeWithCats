@model IEnumerable<CafeWithCats.Models.Client>

<h1>Clients</h1>

<a asp-action="Create">Add Client</a>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Age</th>
        <th>Gender</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var client in Model)
    {
        <tr>
            <td>@client.FirstName</td>
            <td>@client.LastName</td>
            <td>@client.Age</td>
            <td>@client.Gender</td>
            <td>@client.Phone</td>
            <td>@client.Email</td>
            <td>
                <a asp-action="Details" asp-route-id="@client.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@client.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@client.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>