@model IEnumerable<CafeWithCats.Models.Staff>

<h1>Staffs</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Staff</a>
</p>

<table class="table">
    <thead>
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Age</th>
        <th>Gender</th>
        <th>Position</th>
        <th>Work Phone</th>
        <th>Work Email</th>
        <th>Salary</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.FirstName</td>
            <td>@s.LastName</td>
            <td>@s.Age</td>
            <td>@s.Gender</td>
            <td>@s.Position</td>
            <td>@s.WorkPhone</td>
            <td>@s.WorkEmail</td>
            <td>@s.Salary</td>
            <td>
                <a asp-action="Details" asp-route-id="@s.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@s.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@s.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>