@model IEnumerable<CafeWithCats.Models.Cat>

<h1>Cats</h1>

<p>
    <a asp-action="Create">Create New Cat</a>
</p>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Name</th>
        <th>Breed</th>
        <th>Gender</th>
        <th>Schedule</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var cat in Model)
    {
        <tr>
            <td>@cat.Name</td>
            <td>@cat.Breed</td>
            <td>@cat.Gender</td>
            <td>@cat.Schedule?.DayOfWeek</td>
            <td>
                <a asp-action="Details" asp-route-id="@cat.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@cat.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@cat.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>