@model CafeWithCats.Models.Cat
@using Microsoft.AspNetCore.Mvc.Rendering

<h1>Create New Cat</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Breed"></label>
        <input asp-for="Breed" />
        <span asp-validation-for="Breed"></span>
    </div>

    <div>
        <label asp-for="Gender"></label>
        <input asp-for="Gender" />
        <span asp-validation-for="Gender"></span>
    </div>

    <div>
        <label asp-for="ScheduleId"></label>
        <select asp-for="ScheduleId" asp-items="@(new SelectList(ViewBag.Schedules, "Id", "DayOfWeek"))"></select>
        <span asp-validation-for="ScheduleId"></span>
    </div>

    <button type="submit">Create</button>
    <a asp-action="Index">Cancel</a>
</form>