@model CafeWithCats.Models.Cat

<h1>Delete Cat</h1>

<h3>Are you sure you want to delete this cat?</h3>

<div>
    <dl class="row">
        <dt>Name</dt>
        <dd>@Model.Name</dd>

        <dt>Breed</dt>
        <dd>@Model.Breed</dd>

        <dt>Gender</dt>
        <dd>@Model.Gender</dd>

        <dt>Schedule</dt>
        <dd>@Model.Schedule?.DayOfWeek</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit">Delete</button>
    <a asp-action="Index">Cancel</a>
</form>