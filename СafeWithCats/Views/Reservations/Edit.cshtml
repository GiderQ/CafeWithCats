@model CafeWithCats.Models.Reservation

@{
    ViewData["Title"] = "Edit Reservation";
}

<h1>Edit Reservation</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="CafeId">Cafe</label>
        <select asp-for="CafeId" class="form-control" asp-items="@(new SelectList(ViewBag.Cafes, "Id", "Name", Model.CafeId))">
            <option value="">-- Select a cafe --</option>
        </select>
        <span asp-validation-for="CafeId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ReservedTime">Reserved Time</label>
        <input asp-for="ReservedTime" class="form-control" type="time" value="@Model.ReservedTime.ToString(@"hh\:mm")" />
        <span asp-validation-for="ReservedTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>