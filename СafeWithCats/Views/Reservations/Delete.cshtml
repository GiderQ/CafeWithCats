@model CafeWithCats.Models.Reservation

@{
    ViewData["Title"] = "Delete Reservation";
}

<h1>Delete Reservation</h1>

<h3>Are you sure you want to delete this reservation?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Cafe</dt>
        <dd class="col-sm-10">@Model.Cafe?.Address</dd>

        <dt class="col-sm-2">Reserved Time</dt>
        <dd class="col-sm-10">@Model.ReservedTime.ToString(@"hh\:mm")</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>