@model IEnumerable<CafeWithCats.Models.Cafe>

<h1>Cafe</h1>
<a asp-action="Create">Create cafe</a>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Address</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var cafe in Model)
    {
        <tr>
            <td>@cafe.Address</td>
            <td>
                <a asp-action="Details" asp-route-id="@cafe.Id">Details</a>
                <a asp-action="Edit" asp-route-id="@cafe.Id">Edit</a>
                <a asp-action="Delete" asp-route-id="@cafe.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>