@model IEnumerable<CafeWithCats.Models.Drink>

<h1>Drinks</h1>

<p>
    <a asp-action="Create">Create Drinks</a>
</p>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Name</th>
        <th>Alcoholic</th>
        <th>Ingredients</th>
        <th>Volume</th>
        <th>Price</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var drink in Model)
    {
        <tr>
            <td>@drink.Name</td>
            <td>@drink.IsAlcoholic</td>
            <td>@drink.Ingredients</td>
            <td>@drink.Volume</td>
            <td>@drink.Price</td>
            <td>
                <a asp-action="Details" asp-route-id="@drink.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@drink.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@drink.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>