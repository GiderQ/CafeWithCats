@model CafeWithCats.Models.Dish

<h1>Редактировать блюдо</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All"></div>

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" />
        <span asp-validation-for="Price"></span>
    </div>

    <div>
        <label asp-for="Weight"></label>
        <input asp-for="Weight" />
        <span asp-validation-for="Weight"></span>
    </div>

    <div>
        <label asp-for="Ingredients"></label>
        <input asp-for="Ingredients" />
        <span asp-validation-for="Ingredients"></span>
    </div>

    <button type="submit">Сохранить</button>
    <a asp-action="Index">Отмена</a>
</form>