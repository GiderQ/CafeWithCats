@model CafeWithCats.Models.Drink

<h1>Create Drinks</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    
    <div>
        <label asp-for="IsAlcoholic"></label>
        <input asp-for="IsAlcoholic" type="checkbox" />
    </div>

    <div>
        <label asp-for="Ingredients"></label>
        <input asp-for="Ingredients" />
        <span asp-validation-for="Ingredients"></span>
    </div>

    <div>
        <label asp-for="Volume"></label>
        <input asp-for="Volume" />
        <span asp-validation-for="Volume"></span>
    </div>

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" />
        <span asp-validation-for="Price"></span>
    </div>

    <button type="submit">Create</button>
    <a asp-action="Index">Return</a>
</form>