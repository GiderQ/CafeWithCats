@model IEnumerable<CafeWithCats.Models.Dish>

<h1>Dish</h1>

<p>
    <a asp-action="Create">Create New Dish</a>
</p>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Weight</th>
        <th>Ingredients</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var dish in Model)
    {
        <tr>
            <td>@dish.Name</td>
            <td>@dish.Price</td>
            <td>@dish.Weight</td>
            <td>@dish.Ingredients</td>
            <td>
                <a asp-action="Details" asp-route-id="@dish.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@dish.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@dish.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>