@model CafeWithCats.Models.Dish

<h1>Create dish</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" />
        <span asp-validation-for="Price"></span>
    </div>

    <div>
        <label asp-for="Weight"></label>
        <input asp-for="Weight" />
        <span asp-validation-for="Weight"></span>
    </div>

    <div>
        <label asp-for="Ingredients"></label>
        <input asp-for="Ingredients" />
        <span asp-validation-for="Ingredients"></span>
    </div>

    <button type="submit">Create</button>
    <a asp-action="Index">Return</a>
</form>