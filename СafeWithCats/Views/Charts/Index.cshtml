@{
    ViewData["Title"] = "Drink Prices Chart";
    var drinkNames = Json.Serialize(ViewBag.DrinkNames);
    var drinkPrices = Json.Serialize(ViewBag.DrinkPrices);
}

<h1 class="page-title">Drink Prices</h1>
<p class="page-subtitle">Cost overview of all drinks</p>

<div class="d-flex gap-2 mb-4">
    <a asp-action="Export" class="btn btn-primary">⬇ Export to Excel</a>
    <a asp-action="Import" class="btn btn-secondary">⬆ Import from Excel</a>
</div>

<div class="card p-3">
    <div class="card-header">Drink Prices (₴)</div>
    <div class="card-body">
        <canvas id="drinkPriceChart"></canvas>
    </div>
</div>

<div class="card p-3 mt-4">
    <div class="card-header">Alcoholic vs Non-Alcoholic Drinks</div>
    <div class="card-body d-flex justify-content-center">
        <div style="max-width: 300px; width: 100%;">
            <canvas id="drinkTypeChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
    new Chart(document.getElementById('drinkPriceChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(drinkNames),
            datasets: [{
                label: 'Price (₴)',
                data: @Html.Raw(drinkPrices),
                backgroundColor: '#c8813a',
                borderColor: '#6b3f1f',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });
    new Chart(document.getElementById('drinkTypeChart'), {
        type: 'pie',
        data: {
            labels: ['Alcoholic', 'Non-Alcoholic'],
            datasets: [{
                data: [@ViewBag.AlcoholicCount, @ViewBag.NonAlcoholicCount],
                backgroundColor: ['#c8813a', '#4a7c59'],
                borderColor: ['#6b3f1f', '#3a6347'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.label}: ${ctx.raw} drinks`
                    }
                }
            }
        }
});
</script>
}